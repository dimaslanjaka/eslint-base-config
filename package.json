{
  "name": "@dimaslanjaka/eslint-base-config",
  "version": "1.0.2",
  "description": "Base ESLint configuration for JavaScript projects",
  "main": "dist/eslint.config.cjs",
  "module": "dist/eslint.config.mjs",
  "types": "dist/eslint.config.d.ts",
  "bin": {
    "ebc-postinstall": "postinstall.cjs",
    "eslint-config-base": "postinstall.cjs",
    "init-ebc": "postinstall.cjs"
  },
  "files": [
    "./eslint.config.js",
    "./.prettierrc.json",
    "./dist",
    "./postinstall.cjs",
    "./.vscode/settings.json",
    "./config/*",
    "./scripts/*.ps1"
  ],
  "exports": {
    ".": {
      "import": "./dist/eslint.config.mjs",
      "require": "./dist/eslint.config.cjs",
      "types": "./dist/eslint.config.d.ts"
    }
  },
  "keywords": [],
  "author": "Dimas Lanjaka",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.js && npm run build-dts && node -e \"require('fs').copyFileSync('.prettierrc.json', './dist/.prettierrc.json')\" && node debug-tgz.mjs",
    "build-dts": "tsc -p tsconfig.dts.json && npx -y rimraf dist/src",
    "pack": "npx -y tarball-packer --normalize-resolutions --yarn",
    "prepare": "husky",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit --bail=1",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint \"src/**/*\" --fix",
    "postinstall": "npx -y binary-collections@https://raw.githubusercontent.com/dimaslanjaka/bin/263fa06/releases/bin.tgz node-executor --exit-code=0 postinstall.cjs",
    "postinstall2": "node postinstall.cjs",
    "clean": "npx -y rimraf dist tmp"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.13.0",
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-syntax-import-assertions": "^7.28.6",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9",
    "@prettier/plugin-xml": "^3.4.2",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/private/release/cross-spawn.tgz",
    "deepmerge": "^4.3.1",
    "eslint": "^9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.3.5",
    "jsonc-parser": "^3.3.1",
    "prettier": "3.8.3",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sh": "^0.18.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-twig": "^1.0.1",
    "react": "^19.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.3",
    "upath": "^3.0.7"
  },
  "devDependencies": {
    "@jest/environment": "^30.4.1",
    "@jest/expect": "^30.4.1",
    "@jest/globals": "^30.4.1",
    "@jest/test-sequencer": "^30.4.1",
    "@jest/types": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "@types/fs-extra": "^11",
    "@types/react": "^19",
    "ansi-colors": "^4.1.3",
    "babel-jest": "^30.4.1",
    "binary-collections": "^2.0.11",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-config": "^30.4.2",
    "jest-mock": "^30.4.1",
    "lint-staged": "16.2.7",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.4",
    "tar-stream": "^3.2.0",
    "ts-jest": "^29.4.11"
  },
  "resolutions": {
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/dd0273f55b21f8c546ba86565b00a2f89151d15a/release/cross-spawn.tgz",
    "binary-collections": "https://github.com/dimaslanjaka/bin/raw/c50682c5c9276c5f07646f33b834987202767f83/releases/bin.tgz",
    "git-command-helper": "https://github.com/dimaslanjaka/git-command-helper/raw/849f10f15740f2c24911bc03e2fe9eb663f854c1/release/git-command-helper.tgz",
    "sbg-utility": "https://github.com/dimaslanjaka/static-blog-generator/raw/1ca385787f7287155b547c5b97d5ffd5bcfab482/packages/sbg-utility/release/sbg-utility.tgz"
  }
}
