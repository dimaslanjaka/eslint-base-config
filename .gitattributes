# Auto-resolve generated checksum file conflicts
# Special cases, run this to set up the merge driver:
# git config merge.resolve_hash.name "Resolve generated checksum"
# Then set the driver command based on your shell:
# git config merge.resolve_hash.driver true
# To verify, run:
# git config --local --get-regexp "^merge"
# git check-attr --all -- src/_auto_gen/checksum.cjs
src/_auto_gen/checksum.cjs eol=lf merge=resolve_hash

# Normalize line endings
* text=auto

# Shell scripts
*.sh text eol=lf
.husky/* text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# JavaScript / CommonJS / ESM
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf

# TypeScript
*.ts text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.tsx text eol=lf

# Configs
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.7z binary
*.gz binary
*.tar binary
*.rar binary
*.pdf binary
*.tgz binary

# Node modules should never be merged
node_modules/** -merge
